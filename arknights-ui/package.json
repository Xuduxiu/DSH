{
  "name": "@local/dsh-arknights-ui",
  "version": "1.0.0",
  "private": true,
  "description": "Arknights / Endfield visual protocol for the DSH Web GUI: Rhodes Island daylight, Rhodes Island night, and Endfield frosted glass.",
  "type": "module",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "LICENSE",
    "README.md",
    "locale/*.json"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  }
}
