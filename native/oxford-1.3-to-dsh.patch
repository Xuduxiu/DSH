+        // Values mirror arknights-ui/client.js. WinForms uses opaque surfaces:
+        // alpha layers, separators and selections are composited on the protocol base.
+        // Keep the standalone Light and Dark instances unchanged.
+        private static XLabPalette Protocol(string name, bool dark, string canvas, string panel, string raised,
+            string ink, string secondary, string muted, string rule, string border, string selection,
+            string brand, string onBrand, string accent, string hover, string pressed,
+            string warning, string success, string error)
+        {
+            return new XLabPalette {
+                Name=name, IsDark=dark, Canvas=Hex(canvas), Panel=Hex(panel), Raised=Hex(raised),
+                TextPrimary=Hex(ink), TextSecondary=Hex(secondary), TextMuted=Hex(muted),
+                Separator=Hex(rule), BorderStrong=Hex(border), Selected=Hex(selection),
+                Interactive=Hex(brand), OnInteractive=Hex(onBrand), FocusRing=Hex(accent),
+                InteractiveHover=Hex(hover), InteractivePressed=Hex(pressed), Warning=Hex(warning),
+                Success=Hex(success), Error=Hex(error), DisabledSurface=Hex(raised), DisabledText=Hex(muted)
+            };
+        }
+        private static readonly XLabPalette RhodesDay=Protocol("罗德岛白昼",false,
+            "E8E4D8","F7F4ED","F1EDE3","171D1C","45514D","6C7772","C2C0B6","ADACA3","BFCAC2",
+            "1B2422","F8F5EB","A67A2B","33403C","101917","A46721","3E7754","A13D3D");
+        private static readonly XLabPalette RhodesNight=Protocol("罗德岛黑夜",true,
+            "090C0E","13181A","192022","E9E3D4","B7B9AF","858E8A","31312E","474640","3E341E",
+            "E7E0CC","0A0E10","D4A64A","FFF7E6","C9C1AF","D09745","67B884","DD6B5B");
+        private static readonly XLabPalette EndfieldGlass=Protocol("终末地玻璃",true,
+            "061014","0C1A1E","122226","E6F7F2","A9CAC5","7FA6A2","243A3C","355353","1E4443",
+            "67E0CF","04110F","67E0CF","8EF0E2","4CC0B0","E0B25D","71D9AC","E28173");
+        private static readonly XLabPalette ConsoleDsh=Protocol("xLab 控制台",true,
+            "0C0E11","14171C","1C2027","F5F6F7","B7BDC8","8C94A3","424955","788598","49345F",
+            "C39BFF","0C0E11","C39BFF","D2B3FF","B48BEF","F28C28","66DBC3","FF8585");
